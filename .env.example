# Copy to .env and fill in. .env is git-ignored.
# Set at least one key; without any, keyword rules are used for tagging.

# Google Gemini (free tier works) - https://aistudio.google.com
GEMINI_API_KEY=
# Anthropic Claude - https://console.anthropic.com
ANTHROPIC_API_KEY=

# Which LLM to use: gemini | claude | keyword (default: gemini if its key is set, else claude)
LLM_PROVIDER=gemini
# Optional model overrides
# GEMINI_MODEL=gemini-2.5-flash
# CLAUDE_MODEL=claude-opus-5-5
