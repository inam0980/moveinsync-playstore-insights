# Copy to .env and fill in. .env is git-ignored.
# Without a key, keyword rules are used for tagging.

# Google Gemini (free tier works) - https://aistudio.google.com
GEMINI_API_KEY=

# gemini | keyword (default: gemini if its key is set)
LLM_PROVIDER=gemini
# Optional model override
# GEMINI_MODEL=gemini-2.5-flash-lite
